<Project Sdk="Microsoft.NET.Sdk">

    <!-- Helpers for tests of projects that use Format Studio, e.g. checking generated C# and Java against the simulator. -->
    <PropertyGroup>
        <RootNamespace>FormatStudio.Testing</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FormatStudio.Core\FormatStudio.Core.csproj" />
        <!-- The runtime generated C# is compiled against by default. -->
        <ProjectReference Include="..\FormatStudio.Runtime\FormatStudio.Runtime.csproj" />
    </ItemGroup>

</Project>
