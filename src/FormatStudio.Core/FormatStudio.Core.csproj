<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>FormatStudio</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FormatStudio.Tests" />
        <InternalsVisibleTo Include="FormatStudio.Testing" />
    </ItemGroup>

    <ItemGroup>
        <!-- The Java runtime is written into the output of the java-stream generator. -->
        <EmbeddedResource Include="..\FormatStudio.Runtime.Java\formatstudio\runtime\*.java" LogicalName="JavaRuntime/%(Filename)%(Extension)" />
        <!-- Built-in libraries: packages every project finds after its own library folders. -->
        <EmbeddedResource Include="Libraries\*.fslib" LogicalName="Libraries/%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
