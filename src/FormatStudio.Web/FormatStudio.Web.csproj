<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>FormatStudio.Web</RootNamespace>
        <!-- "dotnet run" keeps the caller's folder, so that relative project and workspace paths work as typed. -->
        <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MudBlazor" Version="9.11.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FormatStudio.Core\FormatStudio.Core.csproj" />
        <ProjectReference Include="..\FormatStudio.Importers.Mojang\FormatStudio.Importers.Mojang.csproj" />
    </ItemGroup>

</Project>
