@page "/p/{ProjectId}"
@inherits ProjectComponent
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Format Studio</PageTitle>

@if (Projects.Project is { } project)
{
    <MudText Typo="Typo.h5">@project.Settings.Name</MudText>
    @if (project.Settings.Description != null)
    {
        <MudText Typo="Typo.body1" Class="mb-2">@project.Settings.Description</MudText>
    }
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4 mono">@project.FilePath</MudText>

    <MudGrid Spacing="2" Class="mb-4">
        @foreach (var (label, count) in Counts(project))
        {
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.h5">@count</MudText>
                    <MudText Typo="Typo.body2">@label</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudExpansionPanels MultiExpansion="true">
        <MudExpansionPanel Text="Settings" Expanded="false">
            <MudButton Variant="@Variant.Outlined" StartIcon="@Icons.Material.Filled.Settings" Href="@Link("settings")" Class="mb-2">Edit settings</MudButton>
            <pre class="code-block">@project.Settings.ToYaml()</pre>
        </MudExpansionPanel>
        <MudExpansionPanel Text="@($"Diagnostics ({project.Diagnostics.Count(d => d.Severity != Severity.Info)})")" Expanded="true">
            @if (project.Diagnostics.All(d => d.Severity == Severity.Info))
            {
                <MudAlert Severity="MudBlazor.Severity.Success" Dense="true">No errors or warnings.</MudAlert>
            }
            <DiagnosticList Items="project.Diagnostics.Where(d => _showInfo || d.Severity != Severity.Info)" Links="@(d => FixLink(project, d))" />
            <MudSwitch T="bool" @bind-Value="_showInfo" Label="Show overrides and other infos" Color="Color.Primary" />
        </MudExpansionPanel>
        <MudExpansionPanel Text="@($"Tests ({project.Tests.Count})")" Expanded="@(project.Tests.Count > 0)">
            <MudStack Row="@true" Spacing="@(2)" Class="mb-2" AlignItems="@AlignItems.Center">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="() => RunTests(project)">Run tests</MudButton>
                <MudButton Variant="@Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Href="@Link("test/new")">New test</MudButton>
                @if (_testResults.Count > 0)
                {
                    <MudText Typo="@Typo.body2">@_testResults.Values.Count(r => r.Passed) passed, @_testResults.Values.Count(r => r.Failed) failed, @_testResults.Values.Count(r => r.Skipped) skipped</MudText>
                }
                @if (_acceptable.Count > 0)
                {
                    <MudTooltip Text="Write what the failed cases give (hex, expected values, warnings, lengths) into their files, as test --update does">
                        <MudButton Variant="@Variant.Outlined" Color="@Color.Warning" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="AcceptAll">Accept all actual (@_acceptable.Count)</MudButton>
                    </MudTooltip>
                }
            </MudStack>
            <MudSimpleTable Dense="true">
                <thead><tr><th>Test</th><th>Type</th><th>Tags</th><th>Expected bytes</th><th>Result</th><th></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < project.Tests.Count; i++)
                    {
                        var test = project.Tests[i];
                        var index = i;
                        var outcome = _testResults.GetValueOrDefault(test)?.Summary ?? (test.Skip != null ? "skipped: " + test.Skip : null);
                        <tr>
                            <td><MudLink Href="@Link($"test/{index}")">@test.Name</MudLink> <span class="mud-text-secondary">@test.Suite</span></td>
                            <td>
                                @if (test.Type != null)
                                {
                                    <MudLink Href="@Link($"type/{test.Type}")">@test.Type</MudLink>
                                }
                                else
                                {
                                    <span class="mud-text-secondary">@test.Subject</span>
                                }
                                @if (test.Fuzz != null)
                                {
                                    <span class="mud-text-secondary"> (fuzz)</span>
                                }
                            </td>
                            <td>@string.Join(", ", test.Tags)</td>
                            <td class="mono" title="@(test.Hex ?? test.File)">@Truncate(test.Hex ?? test.File)</td>
                            <td title="@outcome" class="@(_testResults.GetValueOrDefault(test)?.Failed == true ? "mud-error-text" : null)">@Truncate(outcome)</td>
                            <td class="row-buttons">
                                @if (_acceptable.Contains(test))
                                {
                                    <MudTooltip Text="Accept actual: write what the case gives into its file">
                                        <MudIconButton Icon="@Icons.Material.Filled.Done" Size="@Size.Small" Color="@Color.Warning" OnClick="() => Accept(test)" />
                                    </MudTooltip>
                                }
                                <MudTooltip Text="View and debug">
                                    <MudIconButton Icon="@Icons.Material.Filled.BugReport" Size="@Size.Small" Href="@Link($"test/{index}")" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="@Size.Small" OnClick="() => Delete(test)" />
                                </MudTooltip>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@code {
    private bool _showInfo;
    private readonly Dictionary<TestCaseDef, CaseResult> _testResults = [];
    /// <summary>Failed cases whose actual results can be accepted.</summary>
    private readonly HashSet<TestCaseDef> _acceptable = [];

    /// <summary>The page a diagnostic is fixed on, as a link inside this project.</summary>
    private DiagnosticLink? FixLink(FormatProject project, Diagnostic diagnostic) =>
        DiagnosticLinks.For(project, diagnostic) is { } link ? link with { Page = Link(link.Page) } : null;

    private static IEnumerable<(string, int)> Counts(FormatProject project) =>
    [
        ("packets", project.Packets.Count()),
        ("structs", project.Types.Values.Count(t => t is StructDef { IsPacket: false })),
        ("variants", project.Types.Values.Count(t => t is VariantDef)),
        ("enums", project.Types.Values.Count(t => t is EnumDef)),
        ("aliases", project.Types.Values.Count(t => t is AliasDef)),
        ("bitfields", project.Types.Values.Count(t => t is BitfieldDef)),
    ];

    /// <summary>Hex and results longer than this are cut in the table; the full text is in the tooltip.</summary>
    private const int MaxShown = 48;

    private static string? Truncate(string? text) => text is { Length: > MaxShown } ? text[..MaxShown] + "\u2026" : text;

    private void RunTests(FormatProject project)
    {
        _testResults.Clear();
        foreach (var result in TestRunner.Run(project)) _testResults[result.Case] = result;
        _acceptable.Clear();
        foreach (var result in _testResults.Values.Where(Projects.CanAccept)) _acceptable.Add(result.Case);
    }

    private void Accept(TestCaseDef test)
    {
        try
        {
            var keys = Projects.AcceptTest(test);
            Snackbar.Add($"Updated {string.Join(", ", keys)} of '{test.Name}'.", MudBlazor.Severity.Success);
        }
        catch (Exception e) when (e is FormatDefinitionException or IOException or UnauthorizedAccessException or YamlDotNet.Core.YamlException)
        {
            Snackbar.Add($"Not updated: {e.Message}", MudBlazor.Severity.Error);
        }

        // The cases are read again with the project, so their results are of the new ones.
        if (Projects.Project is { } project) RunTests(project);
    }

    private void AcceptAll()
    {
        var outcomes = Projects.AcceptAll();
        var updated = outcomes.Count(o => o.Updated.Count > 0);
        var kept = outcomes.Where(o => o.Reason != null).ToList();
        Snackbar.Add($"Updated {updated} {(updated == 1 ? "case" : "cases")}" + (kept.Count > 0 ? $"; {kept.Count} still fail, e.g. {kept[0].Case.Name}: {kept[0].Reason}" : "."),
            kept.Count > 0 ? MudBlazor.Severity.Warning : MudBlazor.Severity.Success);
        if (Projects.Project is { } project) RunTests(project);
    }

    private async Task Delete(TestCaseDef test)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete test", $"Delete '{test.Name}' from {test.Source?.File}?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;
        try
        {
            Projects.DeleteTest(test);
            Snackbar.Add($"Deleted '{test.Name}'.", MudBlazor.Severity.Success);
        }
        catch (Exception e) when (e is FormatDefinitionException or IOException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Not deleted: {e.Message}", MudBlazor.Severity.Error);
        }
    }
}
