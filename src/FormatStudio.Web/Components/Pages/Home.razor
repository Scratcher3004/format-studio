@page "/p/{ProjectId}"
@inherits ProjectComponent
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Format Studio</PageTitle>

@if (Projects.Project is { } project)
{
    <MudText Typo="Typo.h5">@project.Settings.Name</MudText>
    @if (project.Settings.Description != null)
    {
        <MudText Typo="Typo.body1" Class="mb-2">@project.Settings.Description</MudText>
    }
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4 mono">@project.FilePath</MudText>

    <MudGrid Spacing="2" Class="mb-4">
        @foreach (var (label, count) in Counts(project))
        {
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.h5">@count</MudText>
                    <MudText Typo="Typo.body2">@label</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudExpansionPanels MultiExpansion="true">
        <MudExpansionPanel Text="Settings" Expanded="false">
            <pre class="code-block">@project.Settings.ToYaml()</pre>
        </MudExpansionPanel>
        <MudExpansionPanel Text="@($"Diagnostics ({project.Diagnostics.Count(d => d.Severity != Severity.Info)})")" Expanded="true">
            @if (project.Diagnostics.All(d => d.Severity == Severity.Info))
            {
                <MudAlert Severity="MudBlazor.Severity.Success" Dense="true">No errors or warnings.</MudAlert>
            }
            <DiagnosticList Items="project.Diagnostics.Where(d => _showInfo || d.Severity != Severity.Info)" />
            <MudSwitch T="bool" @bind-Value="_showInfo" Label="Show overrides and other infos" Color="Color.Primary" />
        </MudExpansionPanel>
        <MudExpansionPanel Text="@($"Samples ({project.Samples.Count})")" Expanded="@(project.Samples.Count > 0)">
            <MudStack Row="@true" Spacing="@(2)" Class="mb-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="() => RunSamples(project)">Run samples</MudButton>
                <MudButton Variant="@Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Href="@Link("sample/new")">New sample</MudButton>
            </MudStack>
            <MudSimpleTable Dense="true">
                <thead><tr><th>Sample</th><th>Type</th><th>Expected hex</th><th>Result</th><th></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < project.Samples.Count; i++)
                    {
                        var sample = project.Samples[i];
                        var index = i;
                        <tr>
                            <td><MudLink Href="@Link($"sample/{index}")">@sample.Name</MudLink></td>
                            <td><MudLink Href="@Link($"type/{sample.Type}")">@sample.Type</MudLink></td>
                            <td class="mono" title="@sample.Hex">@Truncate(sample.Hex)</td>
                            <td title="@_sampleResults.GetValueOrDefault(sample)">@Truncate(_sampleResults.GetValueOrDefault(sample))</td>
                            <td class="row-buttons">
                                <MudTooltip Text="View and debug">
                                    <MudIconButton Icon="@Icons.Material.Filled.BugReport" Size="@Size.Small" Href="@Link($"sample/{index}")" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="@Size.Small" OnClick="() => Delete(sample)" />
                                </MudTooltip>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@code {
    private bool _showInfo;
    private readonly Dictionary<SampleDef, string> _sampleResults = [];

    private static IEnumerable<(string, int)> Counts(FormatProject project) =>
    [
        ("packets", project.Packets.Count()),
        ("structs", project.Types.Values.Count(t => t is StructDef { IsPacket: false })),
        ("variants", project.Types.Values.Count(t => t is VariantDef)),
        ("enums", project.Types.Values.Count(t => t is EnumDef)),
        ("aliases", project.Types.Values.Count(t => t is AliasDef)),
        ("bitfields", project.Types.Values.Count(t => t is BitfieldDef)),
    ];

    /// <summary>Hex and results longer than this are cut in the table; the full text is in the tooltip.</summary>
    private const int MaxShown = 48;

    private static string? Truncate(string? text) => text is { Length: > MaxShown } ? text[..MaxShown] + "\u2026" : text;

    private void RunSamples(FormatProject project)
    {
        _sampleResults.Clear();
        foreach (var sample in project.Samples) _sampleResults[sample] = Projects.CheckSample(sample);
    }

    private async Task Delete(SampleDef sample)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete sample", $"Delete '{sample.Name}' from {sample.Source?.File}?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;
        try
        {
            Projects.DeleteSample(sample);
            Snackbar.Add($"Deleted '{sample.Name}'.", MudBlazor.Severity.Success);
        }
        catch (Exception e) when (e is FormatDefinitionException or IOException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Not deleted: {e.Message}", MudBlazor.Severity.Error);
        }
    }
}
