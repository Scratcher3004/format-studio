@page "/p/{ProjectId}/test/{Id}"
@page "/p/{ProjectId}/sample/{Id}"
@using System.Text.Json
@using System.Text.RegularExpressions
@inherits ProjectComponent
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@*
    Views, edits, adds and deletes one test. The simulator below decodes the test's hex (or encodes its value) into the
    hex view, so that a test that fails can be debugged byte by byte; its value and hex are what gets saved.
*@

<PageTitle>@(_original?.Name ?? "New test") - Format Studio</PageTitle>

@if (_missing)
{
    <MudAlert Severity="@MudBlazor.Severity.Warning">There is no test @Id. <MudLink Href="@Link("")">Back to the overview</MudLink></MudAlert>
}
else
{
    <MudStack Row="@true" AlignItems="@AlignItems.Center" Spacing="@(2)" Class="mb-1">
        <MudChip T="string" Color="@Color.Primary" Size="@Size.Small">test</MudChip>
        <MudText Typo="@Typo.h5">@(_original?.Name ?? "New test")</MudText>
        @if (_check != null)
        {
            <MudChip T="string" Size="@Size.Small" Variant="@Variant.Outlined" Color="@(_check == "ok" ? Color.Success : Color.Error)"
                     Icon="@(_check == "ok" ? Icons.Material.Filled.Check : Icons.Material.Filled.ErrorOutline)">@Truncate(_check)</MudChip>
        }
    </MudStack>
    @if (_original != null)
    {
        <MudText Typo="@Typo.body2" Class="mud-text-secondary mono mb-3">@_original.Source?.File</MudText>
    }
    @if (Extras() is { Length: > 0 } extras)
    {
        <MudAlert Severity="@MudBlazor.Severity.Normal" Dense="@true" Class="mb-3">@extras. These are kept when saving; edit them in the test file.</MudAlert>
    }

    <MudGrid Spacing="@(2)" Class="mb-2">
        <MudItem xs="12" md="3">
            <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="@Variant.Outlined" Margin="@Margin.Dense" Required="@true" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudAutocomplete T="string" @bind-Value="_type" SearchFunc="SearchType" CoerceValue="@true" MaxItems="@(50)" Label="Type"
                             Variant="@Variant.Outlined" Margin="@Margin.Dense" Dense="@true"
                             HelperText="@(_type is { Length: > 0 } ? Projects.Project?.Find(_type)?.Kind : "a type expression, e.g. Handshake")" />
        </MudItem>
        <MudItem xs="12" md="5">
            <MudAutocomplete T="string" @bind-Value="_file" SearchFunc="SearchFile" CoerceValue="@true" Label="File" Variant="@Variant.Outlined"
                             Margin="@Margin.Dense" Dense="@true" HelperText="Relative to the project; other tests in the file are kept" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" @bind-Value="_tags" Label="Tags" Placeholder="handshake, regression" Variant="@Variant.Outlined" Margin="@Margin.Dense"
                          HelperText="Separated by commas; the suite's tags are added" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" @bind-Value="_skip" Label="Skip" Placeholder="why the case doesn't run" Variant="@Variant.Outlined" Margin="@Margin.Dense"
                          HelperText="Blank: the case runs" />
        </MudItem>
    </MudGrid>

    <MudStack Row="@true" Spacing="@(2)" Class="mb-3">
        <MudButton Variant="@Variant.Filled" Color="@Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Save</MudButton>
        <MudButton Variant="@Variant.Outlined" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="Check">Check</MudButton>
        @if (_original != null && _checkResult != null && Projects.CanAccept(_checkResult))
        {
            <MudTooltip Text="@(Unsaved() ? "Save or revert your changes first: this writes into the saved case" : "Write what the case gives (hex, expected value, warnings, length) into its file")">
                <MudButton Variant="@Variant.Outlined" Color="@Color.Warning" StartIcon="@Icons.Material.Filled.Done" OnClick="Accept"
                           Disabled="@Unsaved()">Accept actual</MudButton>
            </MudTooltip>
        }
        @if (_original != null)
        {
            <MudButton Variant="@Variant.Text" StartIcon="@Icons.Material.Filled.Undo" OnClick="Load">Revert</MudButton>
            <MudButton Variant="@Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="Duplicate">Duplicate</MudButton>
            <MudSpacer />
            <MudButton Variant="@Variant.Text" Color="@Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="Delete">Delete</MudButton>
        }
    </MudStack>

    @if (_checkResult is { Passed: false } checkResult)
    {
        <MudPaper Outlined="@true" Class="pa-3 mb-3">
            <MudText Typo="@Typo.subtitle2" Class="mb-2">Check</MudText>
            <FailureList Result="@checkResult" />
        </MudPaper>
    }

    @if (_base?.Fuzz == null)
    {
        <ExpectEditor Draft="@_expect" Decoded="@_checkResult?.Decoded" />
    }

    @if (_base?.Fuzz != null)
    {
        <MudAlert Severity="@MudBlazor.Severity.Info" Dense="@true">A fuzz case makes up its values; Check runs it.</MudAlert>
    }
    else if (_base?.Packet != null)
    {
        @* The simulator shows a type's bytes, while a packet case's bytes start with the packet id. *@
        <MudGrid Spacing="@(2)">
            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_json" Label="Value (JSON)" Variant="@Variant.Outlined" Lines="@(12)" Class="mono" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_hex" Label="Hex, starting with the packet id" Variant="@Variant.Outlined" Lines="@(12)" Class="mono" />
            </MudItem>
        </MudGrid>
    }
    else if (!string.IsNullOrWhiteSpace(_type))
    {
        <SimulatorPanel Type="@_type" @bind-Json="_json" @bind-HexText="_hex" />
    }
    else
    {
        <MudAlert Severity="@MudBlazor.Severity.Info" Dense="@true">Choose the type of the test to edit its value and bytes.</MudAlert>
    }
}

@code {
    /// <summary>The position in the project's tests, or <c>new</c>.</summary>
    [Parameter] public string Id { get; set; } = "";

    private int? Index => int.TryParse(Id, out var index) ? index : null;

    private TestCaseDef? _original;
    /// <summary>The case whose other keys (file, expect, skip, tags) the edited case keeps: the original, also after Duplicate.</summary>
    private TestCaseDef? _base;
    private bool _missing;
    private string _name = "";
    private string _type = "";
    private string _file = "";
    private string _json = "";
    private string _hex = "";
    private ExpectDraft _expect = new();
    private string _tags = "";
    private string _skip = "";
    private string? _check;
    private CaseResult? _checkResult;
    private string? _loadedId;

    protected override void OnParametersSet()
    {
        if (_loadedId != Id) Load();
    }

    private void Load()
    {
        _loadedId = Id;
        var tests = Projects.Project?.Tests ?? [];
        _original = _base = Index is { } index && index >= 0 && index < tests.Count ? tests[index] : null;
        _missing = _original == null && Id != "new";
        _check = null;
        _checkResult = null;
        if (_original == null)
        {
            _name = _type = "";
            _file = Projects.Project?.DefaultTestFile() ?? "tests/tests.yaml";
            _json = _hex = _tags = _skip = "";
            _expect = new ExpectDraft();
            return;
        }

        _expect = ExpectDraft.From(_original.Expect);
        _tags = string.Join(", ", _original.Tags);
        _skip = _original.Skip ?? "";

        _name = _original.Name;
        _type = _original.Type ?? "";
        _file = _original.Source?.File ?? "";
        _json = _original.Value != null ? JsonValues.ToText(_original.Value) : "";
        // The placeholder isn't hex; the case keeps it until hex is typed (see Edited).
        _hex = _original.HexAuto ? "" : _original.Hex ?? "";
    }

    /// <summary>What the case has besides name, type, value and hex, in a few words.</summary>
    private string Extras()
    {
        if (_base == null) return "";
        var parts = new List<string>();
        if (_base.Packet is { } frame)
        {
            var among = string.Join(", ", new[] { frame.Protocol, frame.Group is { } group ? "group " + group : null }.OfType<string>());
            parts.Add($"bytes start with a {frame.Header} packet id{(among.Length > 0 ? $" ({among})" : "")}");
        }

        if (_base.HexAuto) parts.Add("hex: auto, filled in by Accept actual");
        if (_base.Fuzz is { } fuzz) parts.Add($"fuzz: {fuzz.Iterations} random values per type, seed {fuzz.Seed}");
        if (_base.File != null) parts.Add($"bytes from {_base.File}");
        if (_base.SkipTargets.Count > 0) parts.Add("not run against " + string.Join(", ", _base.SkipTargets.Keys));
        return string.Join("; ", parts);
    }

    private static string Truncate(string text) => text.Length > 80 ? text[..80] + "…" : text;

    private Task<IEnumerable<string>> SearchType(string? text, CancellationToken token) =>
        Task.FromResult((Projects.Project?.Types.Keys ?? [])
            .Where(name => string.IsNullOrWhiteSpace(text) || name.Contains(text, StringComparison.OrdinalIgnoreCase))
            .Order(StringComparer.Ordinal).AsEnumerable());

    private Task<IEnumerable<string>> SearchFile(string? text, CancellationToken token) =>
        Task.FromResult((Projects.Project?.Tests ?? []).Select(s => s.Source?.File).OfType<string>()
            .Append(Projects.Project?.DefaultTestFile()).OfType<string>().Distinct()
            .Where(file => string.IsNullOrWhiteSpace(text) || file.Contains(text, StringComparison.OrdinalIgnoreCase))
            .Order(StringComparer.Ordinal).AsEnumerable());

    /// <summary>The test as edited, or null after showing what is wrong with it.</summary>
    private TestCaseDef? Edited()
    {
        string? problem = null;
        JsonNode? value = null;
        if (string.IsNullOrWhiteSpace(_name)) problem = "The test needs a name.";
        else if (string.IsNullOrWhiteSpace(_type) && _base?.Packet == null && _base?.Fuzz == null) problem = "The test needs a type.";
        else if (string.IsNullOrWhiteSpace(_json) && string.IsNullOrWhiteSpace(_hex) && _base?.File == null && _base?.Fuzz == null)
            problem = "The test needs a value, hex or both.";
        else
        {
            try
            {
                if (!string.IsNullOrWhiteSpace(_type)) Codec.ParseType(_type);
                if (!string.IsNullOrWhiteSpace(_hex)) Hex.Parse(_hex);
                if (!string.IsNullOrWhiteSpace(_json)) value = JsonNode.Parse(_json);
            }
            catch (Exception e) when (e is System.FormatException or JsonException)
            {
                problem = e.Message;
            }
        }

        if (problem != null)
        {
            Snackbar.Add(problem, MudBlazor.Severity.Error);
            return null;
        }

        // Hex from the simulator comes in lines of 16 bytes; tests keep it on one line.
        var hex = string.IsNullOrWhiteSpace(_hex) ? _base?.HexAuto == true ? TestCaseDef.Auto : null : Regex.Replace(_hex.Trim(), @"\s+", " ");
        TestExpectation? expect;
        try
        {
            expect = _base?.Fuzz != null ? _base.Expect : _expect.ToExpectation(hasBytes: hex != null || _base?.File != null);
        }
        catch (JsonException e)
        {
            Snackbar.Add($"The expected value isn't JSON: {e.Message}", MudBlazor.Severity.Error);
            return null;
        }

        return new TestCaseDef
        {
            Name = _name.Trim(),
            Type = string.IsNullOrWhiteSpace(_type) ? null : _type.Trim(),
            Value = value,
            Hex = hex,
            // Typed hex replaces the bytes of a file.
            File = hex == null ? _base?.File : null,
            Expect = expect,
            Packet = _base?.Packet,
            Fuzz = _base?.Fuzz,
            Skip = string.IsNullOrWhiteSpace(_skip) ? null : _skip.Trim(),
            Tags = Tags(),
            SkipTargets = _base?.SkipTargets ?? new Dictionary<string, string>(),
            Suite = _base?.Suite ?? "",
            Source = _base?.Source,
            Entry = _base?.Entry,
        };
    }

    private List<string> Tags() => _tags.Split(',').Select(t => t.Trim()).Where(t => t.Length > 0).Distinct().ToList();

    private void Check()
    {
        if (Edited() is not { } test) return;
        _checkResult = Projects.RunTest(test);
        _check = _checkResult.Summary;
    }

    /// <summary>The fields differ from the saved case.</summary>
    private bool Unsaved()
    {
        if (_original == null) return true;
        JsonNode? value;
        try
        {
            value = string.IsNullOrWhiteSpace(_json) ? null : JsonNode.Parse(_json);
        }
        catch (JsonException)
        {
            return true;
        }

        JsonNode? expect;
        try
        {
            expect = _original.Fuzz != null ? null : _expect.ToExpectation(_original.HasBytes || _original.HexAuto || _hex.Trim().Length > 0)?.ToNode();
        }
        catch (JsonException)
        {
            return true;
        }

        static string Digits(string? hex) => Regex.Replace(hex ?? "", @"\s+", "");
        return _name.Trim() != _original.Name || _type.Trim() != (_original.Type ?? "") || _file.Trim() != _original.Source?.File
               || Digits(_hex) != Digits(_original.HexAuto ? "" : _original.Hex) || !JsonNode.DeepEquals(value, _original.Value)
               || _original.Fuzz == null && !JsonNode.DeepEquals(expect, _original.Expect is { IsEmpty: false } saved ? saved.ToNode() : null)
               || !Tags().Order(StringComparer.Ordinal).SequenceEqual(_original.Tags.Order(StringComparer.Ordinal))
               || (string.IsNullOrWhiteSpace(_skip) ? null : _skip.Trim()) != _original.Skip;
    }

    private void Accept()
    {
        try
        {
            var keys = Projects.AcceptTest(_original!);
            Snackbar.Add($"Updated {string.Join(", ", keys)} of '{_original!.Name}'.", MudBlazor.Severity.Success);
        }
        catch (Exception e) when (e is FormatDefinitionException or IOException or UnauthorizedAccessException or YamlDotNet.Core.YamlException)
        {
            Snackbar.Add($"Not updated: {e.Message}", MudBlazor.Severity.Error);
            return;
        }

        Load();
        Check();
    }

    private void Save()
    {
        if (Edited() is not { } test) return;
        string written;
        try
        {
            written = Projects.SaveTest(test, _file.Trim(), _original);
        }
        catch (Exception e) when (e is FormatDefinitionException or IOException or UnauthorizedAccessException or YamlDotNet.Core.YamlException)
        {
            Snackbar.Add($"Not saved: {e.Message}", MudBlazor.Severity.Error);
            return;
        }

        var tests = Projects.Project?.Tests ?? [];
        var file = Projects.Project?.Relative(written);
        var saved = tests.FindLastIndex(s => s.Source?.File == file && s.Name == test.Name);
        Snackbar.Add($"Saved '{test.Name}' to {file}.", MudBlazor.Severity.Success);
        if (saved < 0) Navigation.NavigateTo(Link(""));
        else if (saved != Index) Navigation.NavigateTo(Link($"test/{saved}"));
        else Load();
    }

    private void Duplicate()
    {
        _original = null;
        _name += "-copy";
        _check = null;
    }

    private async Task Delete()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete test", $"Delete '{_original!.Name}' from {_original.Source?.File}?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;
        try
        {
            Projects.DeleteTest(_original);
        }
        catch (Exception e) when (e is FormatDefinitionException or IOException or UnauthorizedAccessException or YamlDotNet.Core.YamlException)
        {
            Snackbar.Add($"Not deleted: {e.Message}", MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add($"Deleted '{_original.Name}'.", MudBlazor.Severity.Success);
        Navigation.NavigateTo(Link(""));
    }
}
