@page "/p/{ProjectId}/type/{Name}"
@using FormatStudio.Dsl
@inherits ProjectComponent
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Name - Format Studio</PageTitle>

@if (_definition == null)
{
    <MudAlert Severity="MudBlazor.Severity.Warning">There is no type '@Name'.</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
        <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_definition.Kind</MudChip>
        <MudText Typo="Typo.h5">@_definition.Name</MudText>
        @if (_definition is StructDef { IsPacket: true } packet)
        {
            <MudChip T="string" Size="Size.Small">id @packet.Id</MudChip>
            @foreach (var group in packet.Groups)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@group</MudChip>
            }
        }
        @if (_imported)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">imported</MudChip>
        }
    </MudStack>
    @if (_definition.Title != null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Schema name: @_definition.Title</MudText>
    }
    <MudText Typo="Typo.body2" Class="mud-text-secondary mono mb-2">@_definition.Source?.File</MudText>
    @if (_definition.Doc != null)
    {
        <MudText Typo="Typo.body1" Class="mb-2" Style="white-space: pre-wrap">@_definition.Doc</MudText>
    }

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" @bind-ActivePanelIndex="_tab">
        <MudTabPanel Text="Structure">
            <StructureView Definition="_definition" />
        </MudTabPanel>
        <MudTabPanel Text="Simulate">
            <SimulatorPanel Type="@_definition.Name" />
        </MudTabPanel>
        <MudTabPanel Text="Edit">
            @if (_imported)
            {
                <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="mb-2">
                    This file is regenerated by the next import. Save changes as an override to keep them@(_overrideFile != null ? $" ({Projects.Project!.Relative(_overrideFile)})" : "").
                </MudAlert>
            }
            <textarea class="code-editor" rows="28" spellcheck="false" @bind="_text" @bind:event="oninput"></textarea>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Rule" OnClick="Check">Validate</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="() => Save(null)"
                           Disabled="_imported">Save</MudButton>
                @if (_overrideFile != null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SaveAs" OnClick="() => Save(_overrideFile)">
                        Save as override
                    </MudButton>
                }
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Undo" OnClick="Load">Revert</MudButton>
            </MudStack>
            <DiagnosticList Items="_diagnostics" />
        </MudTabPanel>
        <MudTabPanel Text="C#">
            @if (_csharp == null)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Code" OnClick="Generate">Generate</MudButton>
                <MudText Typo="Typo.caption" Class="ml-2">Generates the whole project once (target '@Projects.DefaultTarget.Name').</MudText>
            }
            else
            {
                <pre class="code-block">@_csharp</pre>
            }
        </MudTabPanel>
        <MudTabPanel Text="@($"Used by ({_references.Count})")">
            <MudSimpleTable Dense="true">
                <tbody>
                    @foreach (var (user, where) in _references)
                    {
                        <tr><td><MudLink Href="@Link($"type/{user.Name}")">@user.Name</MudLink></td><td>@user.Kind</td><td class="mono">@where</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public string Name { get; set; } = "";

    private TypeDef? _definition;
    private bool _imported;
    private string? _overrideFile;
    private string _text = "";
    private string? _csharp;
    private int _tab;
    private DiagnosticBag _diagnostics = [];
    private List<(TypeDef User, string Where)> _references = [];
    private string? _loadedName;

    protected override void OnParametersSet()
    {
        if (_loadedName != Name) Load();
    }

    private void Load()
    {
        _loadedName = Name;
        _definition = Projects.Project?.Find(Name);
        _csharp = null;
        _diagnostics = [];
        if (_definition == null) return;
        _imported = Projects.IsImported(_definition);
        _overrideFile = _imported ? Projects.OverrideFile(_definition) : null;
        _text = Projects.Text(_definition);
        _references = Projects.References(Name).ToList();
    }

    private void Check()
    {
        var (parsed, diagnostics) = Projects.Check(_text, _definition!.Source?.File ?? Name + ".yaml");
        _diagnostics = diagnostics;
        if (parsed != null && parsed.Name != Name)
            _diagnostics.Warning($"The name changed to '{parsed.Name}'; saving creates or replaces that type.");
        if (parsed != null && !diagnostics.HasErrors) Snackbar.Add("No errors.", MudBlazor.Severity.Success);
    }

    private void Save(string? file)
    {
        var (parsed, diagnostics) = Projects.Check(_text, _definition!.Source?.File ?? Name + ".yaml");
        _diagnostics = diagnostics;
        if (parsed == null || diagnostics.HasErrors)
        {
            Snackbar.Add("Not saved: fix the errors first.", MudBlazor.Severity.Error);
            return;
        }

        var text = file != null ? DslWriter.Write(parsed) : _text;
        string written;
        try
        {
            written = Projects.Save(_definition, text, file);
        }
        catch (Exception e) when (e is FormatDefinitionException or IOException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Not saved: {e.Message}", MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add($"Saved {Projects.Project?.Relative(written)}.", MudBlazor.Severity.Success);
        if (parsed.Name != Name) Navigation.NavigateTo(Link($"type/{parsed.Name}"));
        else Load();
    }

    private void Generate()
    {
        var output = Projects.Generated(Projects.DefaultTarget);
        var file = output.Files.FirstOrDefault(f => Path.GetFileName(f.Path) == Name + ".g.cs");
        var problems = output.Diagnostics.Where(d => d.Message.StartsWith(Name + ":", StringComparison.Ordinal)).Select(d => d.ToString());
        _csharp = file?.Content ?? (_definition is AliasDef
            ? "// Aliases are inlined where they are used."
            : "// Nothing generated.\n" + string.Join("\n", problems.Select(p => "// " + p)));
    }
}
