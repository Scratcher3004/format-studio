@page "/p/{ProjectId}/type/{Name}"
@using FormatStudio.Codegen
@using FormatStudio.Dsl
@inherits ProjectComponent
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Name - Format Studio</PageTitle>

@if (_definition == null)
{
    <MudAlert Severity="MudBlazor.Severity.Warning">There is no type '@Name'.</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
        <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_definition.Kind</MudChip>
        <MudText Typo="Typo.h5">@_definition.QualifiedName</MudText>
        @if (_definition is StructDef { IsPacket: true } packet)
        {
            <MudChip T="string" Size="Size.Small">id @packet.Id</MudChip>
            @foreach (var group in packet.Groups)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@group</MudChip>
            }
            @foreach (var protocol in Projects.Project?.ProtocolsOf(packet) ?? [])
            {
                <MudChip T="string" Size="@Size.Small" Color="@Color.Info" Variant="@Variant.Outlined" Href="@Link("protocols")">protocol @protocol.Name</MudChip>
            }
        }
        @if (_imported)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">imported</MudChip>
        }
        @if (_definition.Owner is { } library)
        {
            <MudChip T="string" Size="@Size.Small" Color="@Color.Tertiary" Variant="@Variant.Outlined" Icon="@Icons.Material.Filled.LibraryBooks">library @library</MudChip>
        }
    </MudStack>
    @if (_definition.Title != null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Schema name: @_definition.Title</MudText>
    }
    <MudText Typo="Typo.body2" Class="mud-text-secondary mono mb-2">@_definition.Source?.File</MudText>
    @if (_definition.Doc != null)
    {
        <MudText Typo="Typo.body1" Class="mb-2" Style="white-space: pre-wrap">@_definition.Doc</MudText>
    }

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" @bind-ActivePanelIndex="_tab">
        <MudTabPanel Text="Structure">
            <StructureView Definition="_definition" />
        </MudTabPanel>
        <MudTabPanel Text="Simulate">
            <SimulatorPanel Type="@_definition.QualifiedName" />
        </MudTabPanel>
        <MudTabPanel Text="@(_definition.Owner != null ? "Definition" : "Edit")">
            @if (_definition.Owner is { } owner)
            {
                <MudAlert Severity="@MudBlazor.Severity.Info" Dense="@true" Class="mb-2">
                    This definition comes from the library @owner (@owner.Origin) and can't be edited here. It is shown as this project
                    sees it: names qualified with their library, defaults written out. Change it in the library project and pack it again.
                </MudAlert>
                <pre class="code-block">@_text</pre>
            }
            else
            {
            @if (_imported)
            {
                <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="mb-2">
                    This file is regenerated by the next import. Save changes as an override to keep them@(_overrideFile != null ? $" ({Projects.Project!.Relative(_overrideFile)})" : "").
                </MudAlert>
            }
            <DefinitionEditor @bind-Text="_text" FileName="@(_definition.Source?.File ?? Name + ".yaml")" OriginalName="@Name" Rows="28">
                <Actions>
                    <MudStack Row="true" Spacing="2" Class="mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="() => Save(null)"
                                   Disabled="_imported">Save</MudButton>
                        @if (_overrideFile != null)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SaveAs" OnClick="() => Save(_overrideFile)">
                                Save as override
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Undo" OnClick="Load">Revert</MudButton>
                    </MudStack>
                    <DiagnosticList Items="_diagnostics" />
                </Actions>
            </DefinitionEditor>
            }
        </MudTabPanel>
        <MudTabPanel Text="Code">
            @if (_definition.Owner == null)
            {
            <MudStack Row="@true" AlignItems="@AlignItems.Start" Spacing="2" Class="mb-4">
                <div class="grow">
                    <CodegenSkipEditor @bind-Value="_skip" Targets="@(Projects.Project?.Settings.Codegen ?? [])" Generators="@(Projects.Project?.Generators ?? CodeGenerators.BuiltIn)" />
                </div>
                @if (!SameSkip(_skip, _definition.SkipCodegen))
                {
                    <MudButton Variant="@Variant.Filled" Color="@Color.Primary" StartIcon="@Icons.Material.Filled.Save" Class="mt-2" OnClick="@SaveSkip"
                               Disabled="@(_imported && _overrideFile == null)">@(_imported ? "Save as override" : "Save")</MudButton>
                    <MudButton Variant="@Variant.Text" StartIcon="@Icons.Material.Filled.Undo" Class="mt-2" OnClick="@(() => _skip = _definition.SkipCodegen)">Revert</MudButton>
                }
            </MudStack>
            }
            <MudStack Row="@true" AlignItems="@AlignItems.Center" Spacing="2" Class="mb-2">
                <MudSelect T="string" Value="@_targetKey" ValueChanged="@SelectTarget" ToStringFunc="@(key => TargetLabel(FindTarget(key)))" Label="Target"
                           Variant="@Variant.Outlined" Margin="@Margin.Dense" Style="max-width: 420px">
                    @foreach (var target in Projects.PreviewTargets)
                    {
                        <MudSelectItem Value="@Key(target)">@TargetLabel(target)</MudSelectItem>
                    }
                </MudSelect>
                @if (_code == null)
                {
                    <MudButton Variant="@Variant.Outlined" StartIcon="@Icons.Material.Filled.Code" OnClick="@Generate">Generate</MudButton>
                    <MudText Typo="@Typo.caption">Generates the whole project once per target.</MudText>
                }
            </MudStack>
            @if (_code != null)
            {
                <pre class="code-block">@_code</pre>
            }
        </MudTabPanel>
        <MudTabPanel Text="@($"Used by ({_references.Count})")">
            <MudSimpleTable Dense="true">
                <tbody>
                    @foreach (var (user, where) in _references)
                    {
                        <tr><td><MudLink Href="@Link($"type/{user.QualifiedName}")">@user.QualifiedName</MudLink></td><td>@user.Kind</td><td class="mono">@where</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public string Name { get; set; } = "";
    /// <summary>The tab to open: structure, simulate, edit, code or references (e.g. from a diagnostic's Edit button).</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private TypeDef? _definition;
    private bool _imported;
    private string? _overrideFile;
    private string _text = "";
    private string? _code;
    private string? _targetKey;
    /// <summary>The Code tab's skipCodegen, saved on its own.</summary>
    private CodegenSkip? _skip;
    private int _tab;
    private DiagnosticBag _diagnostics = [];
    private List<(TypeDef User, string Where)> _references = [];
    private string? _loadedName;
    private (string, string?)? _loadedTab;

    /// <summary>The <see cref="Tab"/> names, in the order of the tabs.</summary>
    private static readonly string[] TabNames = ["structure", "simulate", "edit", "code", "references"];

    protected override void OnParametersSet()
    {
        if (_loadedName != Name) Load();
        // Only on navigation: switching tabs by hand keeps the query as it is.
        if (_loadedTab != (Name, Tab))
        {
            _loadedTab = (Name, Tab);
            var index = Array.IndexOf(TabNames, Tab?.ToLowerInvariant());
            if (index >= 0) _tab = index;
        }
    }

    private void Load()
    {
        _loadedName = Name;
        _definition = Projects.Project?.Find(Name);
        _code = null;
        _diagnostics = [];
        if (_definition == null) return;
        _skip = _definition.SkipCodegen;
        _imported = Projects.IsImported(_definition);
        _overrideFile = _imported ? Projects.OverrideFile(_definition) : null;
        _text = Projects.Text(_definition);
        _references = Projects.References(_definition).ToList();
    }

    private void Save(string? file)
    {
        var (parsed, diagnostics) = Projects.Check(_text, _definition!.Source?.File ?? Name + ".yaml");
        _diagnostics = [];
        if (parsed == null || diagnostics.HasErrors)
        {
            Snackbar.Add("Not saved: fix the errors first.", MudBlazor.Severity.Error);
            return;
        }

        var text = file != null ? DslWriter.Write(parsed) : _text;
        string written;
        try
        {
            written = Projects.Save(_definition, text, file);
        }
        catch (Exception e) when (e is FormatDefinitionException or IOException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Not saved: {e.Message}", MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add($"Saved {Projects.Project?.Relative(written)}.", MudBlazor.Severity.Success);
        if (parsed.Name != Name) Navigation.NavigateTo(Link($"type/{parsed.Name}"));
        else Load();
    }

    private static bool SameSkip(CodegenSkip? a, CodegenSkip? b) =>
        a?.All == b?.All && (a?.Targets ?? []).SequenceEqual(b?.Targets ?? []);

    /// <summary>
    /// Saves only skipCodegen: the file keeps its other text and comments, and unsaved changes on the Edit tab stay
    /// (with the same change). Imported definitions are saved as an override.
    /// </summary>
    private void SaveSkip()
    {
        var skip = _skip is { All: false, Targets.Count: 0 } ? null : _skip;
        var fileName = _definition!.Source?.File ?? Name + ".yaml";
        var current = Projects.Text(_definition);
        var draft = _text != current ? _text : null;
        var text = DslWriter.SetSkipCodegen(current, skip);
        var (parsed, _) = Projects.Check(text, fileName);
        if (_imported || parsed == null || !SameSkip(parsed.SkipCodegen, skip))
        {
            // Not a plain file (or an unusual layout): write the whole definition.
            var definition = Projects.Check(current, fileName).Definition;
            if (definition == null)
            {
                Snackbar.Add("Not saved: the definition's file has errors.", MudBlazor.Severity.Error);
                return;
            }

            definition.SkipCodegen = skip;
            text = DslWriter.Write(definition);
        }

        string written;
        try
        {
            written = Projects.Save(_definition, text, _imported ? _overrideFile : null);
        }
        catch (Exception e) when (e is FormatDefinitionException or IOException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Not saved: {e.Message}", MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add($"Saved {Projects.Project?.Relative(written)}.", MudBlazor.Severity.Success);
        var hadCode = _code != null;
        Load();
        if (draft != null) _text = DslWriter.SetSkipCodegen(draft, skip);
        if (hadCode) Generate();
    }

    private static string Key(CodegenTarget target) => target.Name + "@" + target.Generator;

    private CodegenTarget FindTarget(string? key)
    {
        var targets = Projects.PreviewTargets;
        return targets.FirstOrDefault(t => Key(t) == key) ?? targets[0];
    }

    private string TargetLabel(CodegenTarget target)
    {
        var title = Projects.Project?.Generators.Find(target.Generator)?.Title ?? target.Generator;
        return Projects.Project?.Settings.Codegen.Contains(target) == true ? $"{target.Name} ({title})" : $"{title}, default options";
    }

    private void SelectTarget(string key)
    {
        _targetKey = key;
        if (_code != null) Generate();
    }

    private void Generate()
    {
        var target = FindTarget(_targetKey);
        _targetKey = Key(target);
        GeneratedOutput output;
        try
        {
            output = Projects.Generated(target);
        }
        catch (FormatDefinitionException e)
        {
            _code = "// " + e.Message;
            return;
        }

        var name = _definition?.QualifiedName ?? Name;
        var file = output.FileOf(name);
        var problems = output.Diagnostics.Where(d => d.Message.StartsWith(name + ":", StringComparison.Ordinal)).Select(d => d.ToString());
        var skipped = _definition?.SkipCodegen?.Skips(target.Name, target.Generator) == true;
        var library = _definition?.Owner != null ? Projects.Project?.Settings.Dependencies.FirstOrDefault(d => d.Library == _definition.Owner.Name) : null;
        _code = file?.Content ?? (_definition is AliasDef ? "// Aliases are inlined where they are used."
            : skipped ? $"// {Name} is skipped by target '{target.Name}' (skipCodegen): its code comes from elsewhere."
            : library?.SkipCodegen == true ? $"// The library {library.Library} is skipped (codegen: {{skip: true}}): its code comes from elsewhere."
            : _definition?.Owner != null && problems.Count() == 0 ? "// The project doesn't use this library definition, so no code is generated for it."
            : "// Nothing generated.\n" + string.Join("\n", problems.Select(p => "// " + p)));
    }
}
