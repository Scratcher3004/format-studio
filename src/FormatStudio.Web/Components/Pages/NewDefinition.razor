@page "/p/{ProjectId}/new"
@inherits ProjectComponent
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>New definition - Format Studio</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">New definition</MudText>
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.body2">Start from:</MudText>
    @foreach (var (kind, template) in Templates)
    {
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => _text = template">@kind</MudButton>
    }
</MudStack>
<DefinitionEditor @bind-Text="_text" FileName="@FileName" Rows="20">
    <Actions>
        <MudStack Row="true" Spacing="2" Class="my-2">
            <MudTextField T="string" @bind-Value="_folder" Label="Folder, relative to the project" Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="Empty: a folder per kind" />
            <MudTextField T="string" @bind-Value="_file" Label="File name" Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="Empty: the definition's name; .yaml is added" />
        </MudStack>
        @if (Projects.Project != null)
        {
            <MudExpansionPanels Elevation="0" Class="mb-2">
                <MudExpansionPanel Text="Browse">
                    <FolderBrowser Root="@Projects.Project.Directory" FilePattern="*.yaml" Picked="Pick" />
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Create">Create</MudButton>
        <DiagnosticList Items="_diagnostics" />
    </Actions>
</DefinitionEditor>

@code {
    private static readonly (string Kind, string Template)[] Templates =
    [
        ("packet", "packet: MyPacket\nid: 0\ngroups: [serverbound]\nfields:\n  - entityId: varint32\n  - name: name\n    type: string\n    maxLength: 16\n"),
        ("struct", "struct: MyStruct\nfields:\n  - x: f32\n  - y: f32\n"),
        ("enum", "enum: MyEnum\ntype: u8\nvalues:\n  first: 0\n  second: 1\n"),
        ("variant", "variant: MyVariant\ntag: varuint32\ncases:\n  - name: empty\n    tag: 0\n  - name: number\n    tag: 1\n    type: i32\n"),
        ("alias", "alias: MyName\ntype: {string: utf8, length: u16}\n"),
        ("bitfield", "bitfield: MyFlags\ntype: u8\nfields:\n  - name: enabled\n    bits: 1\n    type: bool\n  - mode: 3\n"),
    ];

    private string _text = Templates[0].Template;
    private string? _folder;
    private string? _file;
    private DiagnosticBag _diagnostics = [];

    private string FileName => string.IsNullOrWhiteSpace(_file) ? "new.yaml" : _file.Trim();

    /// <summary>The definition to create, or null after reporting why it can't be. The editor shows its parse and validation problems.</summary>
    private TypeDef? Check()
    {
        _diagnostics = [];
        var (definition, diagnostics) = Projects.Check(_text, FileName);
        if (definition == null || diagnostics.HasErrors)
        {
            Snackbar.Add("Not created: fix the errors first.", MudBlazor.Severity.Error);
            return null;
        }

        if (Projects.Project?.Find(definition.Name) != null)
        {
            _diagnostics.Error($"'{definition.Name}' already exists; edit it on its page.");
            return null;
        }

        return definition;
    }

    /// <summary>Picking a folder fills in the folder; picking a file fills in both.</summary>
    private void Pick(string path)
    {
        var directory = Projects.Project!.Directory;
        if (File.Exists(path))
        {
            _file = Path.GetFileName(path);
            path = Path.GetDirectoryName(path)!;
        }

        var relative = Path.GetRelativePath(directory, path);
        _folder = relative == "." ? "" : relative;
    }

    /// <summary>The full path to write the new definition to, or null after reporting why the folder or name can't be used.</summary>
    private string? Target(TypeDef definition)
    {
        var project = Projects.Project!;
        var folder = _folder?.Trim().Trim('"') ?? "";
        var name = _file?.Trim().Trim('"') ?? "";
        if (folder.Length == 0 && name.Length == 0)
        {
            // The source is the placeholder file name used for diagnostics; without it FileFor picks the folder of the kind.
            definition.Source = null;
            return project.FileFor(definition);
        }

        if (name.Length == 0) name = definition.Name;
        if (name.Contains(".."))
        {
            _diagnostics.Error($"The file name '{name}' must not contain '..'.");
            return null;
        }

        if (name.EndsWith(".fstudio", StringComparison.OrdinalIgnoreCase) || name.EndsWith(ProjectSettings.Extension, StringComparison.OrdinalIgnoreCase))
        {
            _diagnostics.Error($"The file name '{name}' is reserved for project files.");
            return null;
        }

        if (!name.EndsWith(".yaml", StringComparison.OrdinalIgnoreCase)) name += ".yaml";

        var directory = Path.GetFullPath(project.Directory);
        var file = Path.GetFullPath(Path.Combine(directory, folder, name));
        if (!FileSandbox.For(directory).Contains(file) || !Projects.Sandbox.Contains(file))
        {
            _diagnostics.Error($"{file} is outside the project folder.");
            return null;
        }

        if (File.Exists(file))
        {
            _diagnostics.Error($"{file} already exists.");
            return null;
        }

        return file;
    }

    private void Create()
    {
        var definition = Check();
        if (definition == null || Projects.Project == null) return;
        var file = Target(definition);
        if (file == null) return;
        Projects.Save(definition, _text, file);
        if (Projects.Project?.Find(definition.Name) == null)
        {
            Snackbar.Add($"Saved {file}, but it is not part of the project's sources.", MudBlazor.Severity.Warning);
            return;
        }

        Navigation.NavigateTo(Link($"type/{definition.Name}"));
    }
}
