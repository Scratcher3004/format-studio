@using System.Text.Json
@inherits ProjectComponent

<MudGrid Spacing="2">
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.subtitle2">Value (JSON)</MudText>
        <textarea class="code-editor" rows="14" spellcheck="false" @bind="_json" @bind:event="oninput" @bind:after="PublishJson"></textarea>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudNumericField T="int" @bind-Value="_seed" Label="Seed" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 120px" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Casino" OnClick="Random">Random value</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="Encode">Encode</MudButton>
        </MudStack>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.subtitle2">Bytes (hex)</MudText>
        <textarea class="code-editor" rows="14" spellcheck="false" @bind="_hex" @bind:event="oninput" @bind:after="PublishHex"></textarea>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Decode">Decode</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Loop" OnClick="RoundTrip">Round trip</MudButton>
            @if (_bytes != null)
            {
                <MudText Typo="Typo.body2">@_bytes.Length bytes@(_consumed != null && _consumed != _bytes.Length ? $", {_consumed} decoded" : "")</MudText>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@if (CanSave)
{
    <div class="mt-2"><SaveAsTest Draft="Draft" /></div>
}
@if (_message != null)
{
    <MudAlert Severity="@_messageSeverity" Class="my-2" Dense="true">@_message</MudAlert>
}
<DiagnosticList Items="_diagnostics" />

@if (_bytes != null && _root != null)
{
    <MudGrid Spacing="2" Class="mt-2">
        <MudItem xs="12" lg="5">
            <MudText Typo="Typo.subtitle2">Annotated bytes</MudText>
            <HexView Bytes="_bytes" Root="_root" @bind-Selected="_selected" />
            @if (_selected != null)
            {
                <MudText Typo="Typo.body2" Class="mt-2 mono">@_selected.Path: @_selected.Type, offset @_selected.Offset, @_selected.Length bytes @_selected.Display</MudText>
            }
        </MudItem>
        <MudItem xs="12" lg="7">
            <MudText Typo="Typo.subtitle2">Structure</MudText>
            <SpanTree Root="_root" @bind-Selected="_selected" />
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter, EditorRequired] public string Type { get; set; } = "";
    /// <summary>
    /// The value as JSON, when bound. Unbound, the panel starts with a default value of the type. Bound, the panel starts
    /// with the given value and hex and shows how the bytes decode (or, without hex, how the value encodes).
    /// </summary>
    [Parameter] public string? Json { get; set; }
    [Parameter] public EventCallback<string> JsonChanged { get; set; }
    /// <summary>The bytes as hex, when bound.</summary>
    [Parameter] public string? HexText { get; set; }
    [Parameter] public EventCallback<string> HexTextChanged { get; set; }
    /// <summary>Offers Save as test for the value and bytes.</summary>
    [Parameter] public bool CanSave { get; set; }

    private string _json = "";
    private string _hex = "";
    private int _seed = 1;
    private byte[]? _bytes;
    private int? _consumed;
    private SpanNode? _root;
    private SpanNode? _selected;
    private DiagnosticBag _diagnostics = [];
    private string? _message;
    private MudBlazor.Severity _messageSeverity;
    private string? _lastType;
    /// <summary>The bound texts last received or sent, to tell changes by the parent from our own.</summary>
    private string? _lastJson, _lastHex;

    private bool Bound => Json != null || HexText != null;

    protected override async Task OnParametersSetAsync()
    {
        var typeChanged = _lastType != Type;
        var jsonChanged = Json != null && Json != _lastJson;
        var hexChanged = HexText != null && HexText != _lastHex;
        if (!typeChanged && !jsonChanged && !hexChanged) return;
        _lastType = Type;
        if (jsonChanged) _json = _lastJson = Json!;
        if (hexChanged) _hex = _lastHex = HexText!;
        if (typeChanged)
        {
            _bytes = null;
            _root = _selected = null;
            _diagnostics = [];
            _message = null;
            if (Json == null) _json = DefaultJson() ?? "";
            if (HexText == null) _hex = "";
        }

        if (!Bound) return;
        if (typeChanged && string.IsNullOrWhiteSpace(_json) && string.IsNullOrWhiteSpace(_hex))
        {
            _json = DefaultJson() ?? "";
            await PublishJson();
        }

        Preview();
    }

    private async Task PublishJson()
    {
        _lastJson = _json;
        await JsonChanged.InvokeAsync(_json);
    }

    private async Task PublishHex()
    {
        _lastHex = _hex;
        await HexTextChanged.InvokeAsync(_hex);
    }

    /// <summary>
    /// Shows the bytes in the hex view without changing the texts: the hex decoded, or without hex, the value encoded.
    /// </summary>
    private void Preview()
    {
        _bytes = null;
        _root = _selected = null;
        _diagnostics = [];
        _message = null;
        if (Codec is not { } codec || string.IsNullOrWhiteSpace(Type)) return;
        try
        {
            var type = Codec.ParseType(Type);
            if (!string.IsNullOrWhiteSpace(_hex))
            {
                var bytes = Hex.Parse(_hex);
                var result = Annotate(codec, type, bytes, updateJson: false);
                Show(result.Success ? $"Decoded {result.Consumed} of {bytes.Length} bytes." : "Decoding failed; the structure shows how far it got.",
                    result.Success ? MudBlazor.Severity.Info : MudBlazor.Severity.Error);
            }
            else if (!string.IsNullOrWhiteSpace(_json))
            {
                var encoded = codec.Encode(type, JsonNode.Parse(_json));
                _diagnostics = encoded.Diagnostics;
                if (!encoded.Success) return;
                Annotate(codec, type, encoded.Bytes, updateJson: false);
                Show($"There is no hex; showing the {encoded.Bytes.Length} bytes the value encodes to.");
            }
        }
        catch (Exception e) when (e is System.FormatException or JsonException or Expressions.ExprException or FormatDefinitionException)
        {
            Show(e.Message, MudBlazor.Severity.Error);
        }
    }

    /// <summary>A zero/empty value of the type as a template to edit, or null when the type does not parse.</summary>
    private string? DefaultJson()
    {
        if (Projects.Project is not { } project) return null;
        try
        {
            return JsonValues.ToText(new DefaultValues(project).Generate(Codec.ParseType(Type)));
        }
        catch (Exception e) when (e is System.FormatException or Expressions.ExprException or FormatDefinitionException)
        {
            return null;
        }
    }

    private Codec? Codec => Projects.Project is { } project ? new Codec(project) : null;

    private bool TryType(out TypeRef type)
    {
        type = null!;
        try
        {
            type = Codec.ParseType(Type);
            return true;
        }
        catch (System.FormatException e)
        {
            Show(e.Message, MudBlazor.Severity.Error);
            return false;
        }
    }

    private void Show(string? message, MudBlazor.Severity severity = MudBlazor.Severity.Info)
    {
        _message = message;
        _messageSeverity = severity;
    }

    private async Task Random()
    {
        if (Projects.Project == null || !TryType(out var type)) return;
        try
        {
            _json = JsonValues.ToText(new RandomValues(Projects.Project, _seed++).Generate(type));
            Show(null);
            await PublishJson();
            await Encode();
        }
        catch (Exception e) when (e is Expressions.ExprException or FormatDefinitionException)
        {
            Show(e.Message, MudBlazor.Severity.Error);
        }
    }

    private async Task Encode()
    {
        if (Codec is not { } codec || !TryType(out var type)) return;
        JsonNode? value;
        try
        {
            value = JsonNode.Parse(_json);
        }
        catch (JsonException e)
        {
            Show($"Invalid JSON: {e.Message}", MudBlazor.Severity.Error);
            return;
        }

        var result = codec.Encode(type, value);
        _diagnostics = result.Diagnostics;
        if (!result.Success)
        {
            Show("Encoding failed.", MudBlazor.Severity.Error);
            return;
        }

        _hex = Hex.FormatLines(result.Bytes);
        await PublishHex();
        Show($"Encoded {result.Bytes.Length} bytes.", MudBlazor.Severity.Success);
        Annotate(codec, type, result.Bytes, updateJson: false);
    }

    private async Task Decode()
    {
        if (Codec is not { } codec || !TryType(out var type)) return;
        byte[] bytes;
        try
        {
            bytes = Hex.Parse(_hex);
        }
        catch (System.FormatException e)
        {
            Show($"Invalid hex: {e.Message}", MudBlazor.Severity.Error);
            return;
        }

        _diagnostics = [];
        var result = Annotate(codec, type, bytes, updateJson: true);
        if (result.Value != null) await PublishJson();
        Show(result.Success ? $"Decoded {result.Consumed} of {bytes.Length} bytes." : "Decoding failed; the structure shows how far it got.",
            result.Success ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }

    private DecodeResult Annotate(Codec codec, TypeRef type, byte[] bytes, bool updateJson)
    {
        var result = codec.Decode(type, bytes);
        _bytes = bytes;
        _consumed = result.Consumed;
        _root = result.Root;
        _selected = null;
        _diagnostics.AddRange(result.Diagnostics);
        if (updateJson && result.Value != null) _json = JsonValues.ToText(result.Value);
        return result;
    }

    /// <summary>The value and bytes as they are now, with what the bytes decode to.</summary>
    private TestDraft Draft()
    {
        var type = Codec.ParseType(Type);
        var value = string.IsNullOrWhiteSpace(_json) ? null : JsonNode.Parse(_json);
        var bytes = string.IsNullOrWhiteSpace(_hex) ? null : Hex.Parse(_hex);
        if (value == null && bytes == null) throw new System.FormatException("there is no value or hex");
        var decoded = bytes != null && Codec is { } codec ? codec.Decode(type, bytes) : null;
        return new TestDraft(TestDraft.NameFor(Type), Type.Trim(), value, bytes,
            Decoded: decoded is { Success: true } ? decoded.Value : null,
            Consumed: decoded is { Success: true } && decoded.Consumed < bytes!.Length ? decoded.Consumed : null);
    }

    private void RoundTrip()
    {
        if (Codec is not { } codec || !TryType(out var type)) return;
        RoundTripResult result;
        try
        {
            result = _hex.Trim().Length > 0
                ? Simulator.RoundTripBytes(codec, type, Hex.Parse(_hex))
                : Simulator.RoundTripValue(codec, type, JsonNode.Parse(_json));
        }
        catch (Exception e) when (e is System.FormatException or JsonException)
        {
            Show(e.Message, MudBlazor.Severity.Error);
            return;
        }

        _diagnostics = result.Diagnostics;
        Show(result.Success ? "Round trip OK: decoding and encoding again gives the same bytes." : "Round trip failed.",
            result.Success ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }

}
