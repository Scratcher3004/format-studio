@if (Items.Any())
{
    <MudSimpleTable Dense="true" Hover="true" Class="mb-2">
        <tbody>
            @foreach (var diagnostic in Items.Take(Max))
            {
                <tr>
                    <td style="width: 1%">
                        <MudChip T="string" Size="Size.Small" Color="@Color(diagnostic.Severity)">@diagnostic.Severity</MudChip>
                    </td>
                    <td class="mono">@diagnostic.Source</td>
                    <td>@diagnostic.Message @if (diagnostic.Path != null) { <span class="mud-text-secondary"> [@diagnostic.Path]</span> }</td>
                    @if (Links != null)
                    {
                        <td style="width: 1%; white-space: nowrap">
                            @if (Links(diagnostic) is { } link)
                            {
                                <MudButton Variant="@Variant.Text" Size="@Size.Small" StartIcon="@link.Icon" Href="@link.Page">@link.Label</MudButton>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    @if (Items.Count() > Max)
    {
        <MudText Typo="Typo.caption">@(Items.Count() - Max) more not shown.</MudText>
    }
}

@code {
    [Parameter] public IEnumerable<Diagnostic> Items { get; set; } = [];
    [Parameter] public int Max { get; set; } = 200;
    /// <summary>A button per diagnostic to the page where it is fixed (an absolute link), or null for none.</summary>
    [Parameter] public Func<Diagnostic, DiagnosticLink?>? Links { get; set; }

    private static MudBlazor.Color Color(Severity severity) => severity switch
    {
        Severity.Error => MudBlazor.Color.Error,
        Severity.Warning => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Info,
    };
}
