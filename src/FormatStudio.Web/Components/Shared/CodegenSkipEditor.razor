@using FormatStudio.Codegen
@* Edits a definition's skipCodegen: generated by every target, skipped by every target, or skipped by some. *@
<div class="builder-row">
    <MudSelect T="string" Value="@Mode" ValueChanged="@SetMode" Label="Code generation" Variant="@Variant.Outlined"
               Margin="@Margin.Dense" Style="min-width: 260px" HelperText="Skipped definitions are referenced but not generated, e.g. because they are written by hand">
        <MudSelectItem Value="@("generate")">Generated by every target</MudSelectItem>
        <MudSelectItem Value="@("all")">Skipped by every target</MudSelectItem>
        <MudSelectItem Value="@("some")">Skipped by some targets</MudSelectItem>
    </MudSelect>
    @if (Value is { All: false } skip)
    {
        <MudSelect T="string" MultiSelection="@true" SelectedValues="@skip.Targets" SelectedValuesChanged="@SetSkipped"
                   ToStringFunc="@Label" Label="Skipped by" Variant="@Variant.Outlined" Margin="@Margin.Dense" Class="grow"
                   HelperText="Targets, or generators (every target using them)" Error="@(skip.Targets.Count == 0)" ErrorText="Choose at least one">
            @foreach (var name in Choices)
            {
                <MudSelectItem Value="@name">@Label(name)</MudSelectItem>
            }
        </MudSelect>
    }
</div>

@code {
    [Parameter] public CodegenSkip? Value { get; set; }
    [Parameter] public EventCallback<CodegenSkip?> ValueChanged { get; set; }
    /// <summary>The project's codegen targets, offered by name.</summary>
    [Parameter] public IReadOnlyList<CodegenTarget> Targets { get; set; } = [];
    /// <summary>The project's generators.</summary>
    [Parameter] public CodeGenerators Generators { get; set; } = CodeGenerators.BuiltIn;

    private string Mode => Value switch
    {
        null => "generate",
        { All: true } => "all",
        _ => "some",
    };

    private Task SetMode(string mode) => ValueChanged.InvokeAsync(mode switch
    {
        "all" => CodegenSkip.Everywhere,
        // Until targets are chosen the list is empty, which saves like "generate".
        "some" => Value is { All: false } current ? current : new CodegenSkip(false, []),
        _ => null,
    });

    private Task SetSkipped(IEnumerable<string>? names) =>
        ValueChanged.InvokeAsync(new CodegenSkip(false, Choices.Where(n => names?.Contains(n) == true).ToList()));

    /// <summary>The project's targets, then the generators, then names in the definition that are neither.</summary>
    private IReadOnlyList<string> Choices => Targets.Select(t => t.Name)
        .Concat(Generators.All.Select(g => g.Name))
        .Concat(Value?.Targets ?? [])
        .Distinct(StringComparer.Ordinal).ToList();

    private string Label(string? name)
    {
        if (name == null) return "";
        if (Targets.FirstOrDefault(t => t.Name == name) is { } target) return $"Target {name} ({target.Generator})";
        if (Generators.Find(name) is { } generator) return $"All {generator.Title} targets";
        return $"{name} (unknown)";
    }
}
